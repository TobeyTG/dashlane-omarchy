#!/usr/bin/env bash
# Regenerate the "Passwords" submenu in ~/.config/omarchy/extensions/omarchy-menu.jsonc
# from the Dashlane vault. Only titles/logins are written — never secrets.
# Usage: dashlane-menu-sync [vault.json]   (file arg = offline/test input)
set -euo pipefail
menu=${DASHLANE_MENU_FILE:-$HOME/.config/omarchy/extensions/omarchy-menu.jsonc}
src=${1:-}

strip='map({id,title,url,login,email,hasOtp:((.otpSecret // "") != "")})'
if [[ -n $src ]]; then json=$(jq "$strip" "$src"); else json=$(dashlane-list); fi   # metadata only — secrets never enter this script

# ids go into shell command strings: allow only the characters Dashlane actually uses
bad=$(jq -r '.[].id' <<<"$json" | grep -vE '^[{}A-Za-z0-9_-]+$' || true)
[[ -z $bad ]] || { echo "skipping entries with unexpected ids: $bad" >&2; json=$(jq 'map(select(.id|test("^[{}A-Za-z0-9_-]+$")))' <<<"$json"); }
block=$(jq -r '
  sort_by(.title // .url // "" | ascii_downcase) | to_entries[] | .value as $c |
  ($c.title // $c.url // "untitled") as $label |
  ($c.login // $c.email // "") as $login |
  "  \"passwords.\(.key)\": {\"icon\":\"󰌾\",\"label\":\($label|tojson),\"description\":\($login|tojson)},\n" +
  "  \"passwords.\(.key).pw\": {\"icon\":\"󰌾\",\"label\":\"Copy password\",\"action\":\"dashlane-copy \($c.id) password\"},\n" +
  "  \"passwords.\(.key).login\": {\"icon\":\"󰀄\",\"label\":\"Copy login\",\"action\":\"dashlane-copy \($c.id) \(if ($c.login // "") != "" then "login" else "email" end)\"},\n" +
  (if $c.hasOtp then "  \"passwords.\(.key).otp\": {\"icon\":\"󰦝\",\"label\":\"Copy OTP\",\"action\":\"dashlane-copy \($c.id) otp\"}," else "" end)
' <<<"$json")

start='  // >>> dashlane-omarchy (generated, do not edit)'
end='  // <<< dashlane-omarchy'
genf=$(mktemp)
{
  echo "$start"
  echo '  "passwords": {"icon":"󰌆","label":"Passwords","aliases":["dashlane","pw"]},'
  echo '  "passwords.sync": {"icon":"󰑐","label":"Sync vault","action":"dashlane-sync"},'
  echo '  "passwords.app": {"icon":"󰆍","label":"Open app","action":"dashlane-app"},'
  echo "$block"   # trailing comma stays: a user entry may follow; Omarchy's stripJsonc drops it before "}"
  echo "$end"
} > "$genf"

mkdir -p "$(dirname "$menu")"
[[ -f $menu ]] || printf '{\n}\n' > "$menu"
# drop old block, then insert new one right after the opening brace
tmp=$(mktemp)
awk -v s="$start" -v e="$end" '$0==s{skip=1} !skip{print} $0==e{skip=0}' "$menu" | sed "0,/^{/{/^{/r $genf
}" > "$tmp"
mv "$tmp" "$menu"; rm "$genf"
echo "wrote $(grep -c '"passwords\.[0-9]*":' "$menu") entries to $menu"
