#!/usr/bin/env bash
# dashlane-copy <id> [password|login|email|otp] [label] — copy one field to the clipboard.
# dashlane-copy --stdin <field> [label]              — copy a value the caller already fetched (read from stdin).
# --quiet (first arg) suppresses the desktop notification; the app and bar popup show their own toast.
# One dcli call on the happy path (dcli costs ~0.6s per invocation). Security: the secret only
# ever travels through pipes (never argv, never disk). --sensitive keeps it out of clipboard
# history (Omarchy honours the hint); cleared after 30s. If the vault is locked, opens a terminal
# with the official CLI login (dcli sync) and retries.
set -euo pipefail
export PATH="$PATH:$HOME/.local/bin"   # fallback only, never shadows: where install.sh puts dcli; callers (shell, hypridle) may lack it
[[ $# -ge 1 ]] || { echo "usage: dashlane-copy [--quiet] <id> [password|login|email|otp] [label] | --stdin <field> [label]" >&2; exit 2; }
notify() { [[ -n $quiet ]] || notify-send -a Dashlane -t 1500 "$@" 2>/dev/null || true; }
quiet=""; [[ ${1:-} == --quiet ]] && { quiet=1; shift; }
if [[ $1 == --stdin ]]; then
  field=$2; label=${3:-}; secret=$(cat)
  [[ -n $secret ]] || exit 1
else
id=$1; field=${2:-password}; label=${3:-}
get() {  # login falls back to email (dcli errors if the entry has only one of them)
  local f; for f in "$field" $([[ $field == login ]] && echo email); do
    timeout 20 dcli p "id=$id" -f "$f" -o console </dev/null 2>/dev/null && return; done; return 1
}
if ! secret=$(get); then
  if ! timeout 20 dcli p "id=$id" -o json </dev/null >/dev/null 2>&1; then   # locked → login, retry
    notify "Dashlane" "Vault locked — log in with the official Dashlane CLI in the terminal"
    omarchy-launch-floating-terminal-with-presentation "dcli sync" || true
    # The launcher detaches, so wait for a `dcli sync` process to appear and finish — bounded.
    # Login needs email + master password + a device code that Dashlane e-mails; slow mail is
    # common, hence 5 minutes. DASHLANE_LOGIN_TIMEOUT (seconds) overrides it (tests use 2).
    login_running() { pgrep -x dcli -a 2>/dev/null | grep -qE '(^|[[:space:]])dcli[[:space:]]+sync([[:space:]]|$)'; }
    for _ in $(seq 1 20); do login_running && break; sleep 0.5; done
    for _ in $(seq 1 "${DASHLANE_LOGIN_TIMEOUT:-300}"); do login_running || break; sleep 1; done
    secret=$(get) || { notify "Dashlane" "Login did not complete — vault still locked"; exit 1; }
  else
    notify-send -a Dashlane -u critical "Dashlane" "No $field on this entry" 2>/dev/null; exit 1
  fi
fi
fi
# --sensitive (wl-clipboard ≥ 2.2.2) keeps the value out of Omarchy's clipboard history; older
# versions lack the flag, so feature-detect it. setsid: the server must survive the caller exiting.
sensitive=(); wl-copy --help 2>&1 | grep -q -- --sensitive && sensitive=(--sensitive)
if [[ -z ${sensitive[*]} ]]; then   # warn once per session: the value will land in clipboard history
  mark=${XDG_RUNTIME_DIR:-/tmp}/dashlane-copy.no-sensitive
  [[ -e $mark ]] || { touch "$mark"; notify-send -a Dashlane -u normal "Dashlane" "wl-clipboard < 2.2.2: copied values are not hidden from clipboard history" 2>/dev/null || true; }
fi
printf '%s' "$secret" | tr -d '\n' | setsid wl-copy "${sensitive[@]}" -t text/plain
notify "Dashlane" "Copied $field${label:+ for $label} (clears in 30s)"
# fallback clear: after 30s, wipe the clipboard if it still holds this secret (compared via stdin, not argv)
# shellcheck disable=SC2016  # $s is expanded by the inner bash on purpose
printf '%s' "$secret" | tr -d '\n' | setsid bash -c 'IFS= read -r s; sleep 30; [[ "$(wl-paste -n 2>/dev/null)" == "$s" ]] && wl-copy --clear' >/dev/null 2>&1 &
